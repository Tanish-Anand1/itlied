# ---------------------------------------------------------------------------
# Supabase (local CLI or cloud — same migrations)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# ---------------------------------------------------------------------------
# Web (Next.js)
# ---------------------------------------------------------------------------
RUNNER_URL=http://localhost:8080
NEXT_PUBLIC_LAUNCH_AT=2026-08-01T00:00:00Z
# SUBMIT_RATE_LIMIT_PER_HOUR=20
# NEXT_PUBLIC_DEMO=1

# Auth redirect (must match Supabase Auth URL config)
# SITE_URL=http://localhost:3000

# Google OAuth (local Supabase — also put in supabase/.env)
# GOOGLE_CLIENT_ID=....apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-...
# Authorized redirect URI in Google Cloud Console:
#   http://127.0.0.1:54321/auth/v1/callback

# GitHub OAuth (optional)
# 1. GitHub → Settings → Developer settings → OAuth Apps → New
# 2. Homepage: http://127.0.0.1:3000
# 3. Callback: http://127.0.0.1:54321/auth/v1/callback
# 4. Put id/secret in supabase/.env AND set [auth.external.github] enabled=true
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# Then: supabase stop && supabase start --ignore-health-check

# Local magic-link inbox (Mailpit): http://127.0.0.1:54324

# ---------------------------------------------------------------------------
# Runner (long-lived — Render/Railway, NOT Vercel)
# ---------------------------------------------------------------------------
# Provider keys (runner routes each model to the right base URL automatically)
OPENAI_API_KEY=sk-...
# NVIDIA_API_KEY=nvapi-...
# FIREWORKS_API_KEY=fw_...
# OPENROUTER_API_KEY=sk-or-...
# Optional fallback base when match.model_id is missing:
OPENAI_BASE_URL=https://api.openai.com/v1
# ARENA_MODEL=gpt-4.1-mini

RUNNER_PORT=8080
DAILY_BUDGET_CENTS=5000
TOKEN_CEILING=80000
SANDBOX_IMAGE=agentarena-sandbox:v1
SITE_URL=http://localhost:3000
SITE_NAME=ItLied

# Shared secret: web → runner /matches/:id/start (required in prod)
RUNNER_SHARED_SECRET=change-me-local-dev

# Host path Docker can bind for per-match workdirs (Windows: use a short path
# under your user dir if Desktop file sharing blocks the repo disk).
# WORK_ROOT=C:/arena-work

# Local host-exec fallback ONLY — E2E smoke refuses these:
# ARENA_NO_DOCKER=1
# DRY_RUN=1
